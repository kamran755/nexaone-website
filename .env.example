# Copy to .env and fill in. Never commit .env or share it.
# Enables the live AI chatbot. Leave empty to stay in clearly labelled demo mode.
ANTHROPIC_API_KEY=
# Model used by the chatbot (check Anthropic docs for current model names)
AI_MODEL=claude-sonnet-4-6
# Optional: lets the server deliver contact-form emails via Web3Forms (set CONTACT_MODE to "server" in script.js)
WEB3FORMS_KEY=
# Only if the static site is hosted on a different domain than this server, e.g. https://www.example.com
ALLOWED_ORIGIN=
PORT=3000
